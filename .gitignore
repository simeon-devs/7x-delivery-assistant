# ---------------------------------------------------------------- secrets
.env
.env.*
!.env.example
*.key
*.pem

# ---------------------------------------------------------------- client material
# The client's brief and the shipment dataset were sent by 7X and are confidential.
# They never go into a repository, private or not.
7X_Brief.pdf
7X_Shipment_Dataset.xlsx
*.xlsx
*.pdf

# Our own deliverables are the exception, named one by one. A blanket !docs/*.pdf would
# let a client PDF dropped into docs/ straight through the rule above.
!docs/7X-market-scan.pdf

# ---------------------------------------------------------------- data
# Nothing in data/ is committed. It holds customer names, phone numbers and addresses
# derived from the client's file, plus scraped public reviews. Every file in here is
# regenerated by the scripts in analysis/, so the code is the artefact, not the data.
data/*
!data/.gitkeep

# ---------------------------------------------------------------- python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------- databases
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------- os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---------------------------------------------------------------- brainstorming
# Visual companion mockups from design sessions. Working material, not the artefact.
.superpowers/
# Specs and plans from design sessions. Working material, kept local.
docs/superpowers/

# ---------------------------------------------------------------- the deck
# Screenshots of the live product. Names and addresses are masked, but they are still
# taken from the client's records, so they stay local, and so does the deck PDF that
# contains them (already caught by *.pdf above; deliberately no exception for it).
docs/deck-shots/
