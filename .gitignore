# ---------------------------------------------------------------- secrets
.env
.env.*
!.env.example
*.key
*.pem

# ---------------------------------------------------------------- client material
# The assignment brief and the shipment dataset were sent by 7X and are confidential.
# They never go into a repository, private or not.
FDE_Assignment_Brief.pdf
FDE_Assignment_Shipment_Dataset.xlsx
*.xlsx
*.pdf

# ---------------------------------------------------------------- data
# Nothing in data/ is committed. It holds customer names, phone numbers and addresses
# derived from the client's file, plus scraped public reviews. Every file in here is
# regenerated by the scripts in analysis/, so the code is the artefact, not the data.
data/*
!data/.gitkeep

# ---------------------------------------------------------------- python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---------------------------------------------------------------- databases
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------- os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
